---
permalink: /
title: "American Watchmaking Directory | Watch Brands, Watchmakers & Suppliers in the USA"
description: "A free, volunteer-run directory of watch brands, independent watchmakers and suppliers in the United States, plus a few of our Canadian neighbors. Search by name, state or type."
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}
{%- set brands = collections.brands -%}
{%- set pick = brands | weeklyPick -%}
{%- set oldestBrand = brands | oldest -%}

{% block head %}
    {{ m.mapAssets() }}
    <style>
        .hero {
            display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center;
            background: var(--paper); border-radius: 24px; padding: 48px; box-shadow: var(--shadow); color: var(--ink);
        }
        .hero h1 { font-family: 'Manrope', sans-serif; font-size: 2.7rem; line-height: 1.12; margin-bottom: 14px; }
        .hero p { font-size: 1.1rem; color: var(--muted); margin-bottom: 22px; }
        .hero-search { display: flex; gap: 10px; margin-bottom: 14px; }
        .hero-search input {
            flex: 1; min-width: 0; padding: 13px 16px; border: 2px solid var(--line); border-radius: 10px;
            font: 400 1.05rem 'Poppins', sans-serif; color: var(--ink); background: #fff;
        }
        .hero-search input:focus { outline: none; border-color: var(--ink); }
        .hero-links { display: flex; gap: 8px 18px; flex-wrap: wrap; font-size: .95rem; }
        .hero-links a { color: var(--ink); font-weight: 500; }
        .hero-img { width: 100%; max-width: 340px; aspect-ratio: 1; object-fit: cover; border-radius: 50%; justify-self: center; box-shadow: 0 20px 40px rgba(0,0,0,.25); border: 6px solid #304047; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 24px 0 0; }
        .stat { background: #fff; border-radius: 14px; padding: 16px 18px; color: var(--ink); box-shadow: 0 4px 14px rgba(0,0,0,.05); }
        .stat b { display: block; font-family: 'Manrope', sans-serif; font-size: 1.8rem; line-height: 1.1; }
        .stat span { font-size: .88rem; color: var(--muted); }
        .stat a { color: inherit; }
        .feature { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: center; }
        .feature h3 { font-family: 'Manrope', sans-serif; font-size: 1.6rem; line-height: 1.2; }
        .feature .eyebrow { text-transform: uppercase; letter-spacing: .06em; font-size: .78rem; font-weight: 600; color: #b08d57; }
        .feature p { color: var(--muted); margin: 4px 0 12px; }
        .feature .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
        @media (max-width: 900px) {
            .hero { grid-template-columns: 1fr; padding: 28px 22px; gap: 20px; }
            .hero-img { display: none; }
            .hero h1 { font-size: 1.9rem; }
            .stats { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 520px) {
            .hero-search { flex-direction: column; }
            .feature { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block main %}
        <section class="hero">
            <div>
                <h1>Find the people making watches in America</h1>
                <p>{{ brands.length }} watch brands, independent watchmakers and suppliers across the United States, plus a few of our Canadian neighbors. Free, independent and run by volunteers.</p>
                <form class="hero-search" action="/directory.html" method="get" role="search">
                    <label for="home-q" class="sr-only">Search the directory</label>
                    <input id="home-q" name="q" type="search" placeholder="Search a brand, city or state">
                    <button class="btn" type="submit">Search</button>
                </form>
                <div class="hero-links">
                    <a href="/directory.html">Browse all {{ brands.length }} &rarr;</a>
                    <a href="/map/">See the map</a>
                    <a href="/states/">By state</a>
                    <a href="/suggest/">Suggest a brand</a>
                </div>
            </div>
            <img class="hero-img" src="/images/watch-movement.jpg" alt="A Hamilton pocket watch movement" width="340" height="340">
        </section>

        <div class="stats">
            <div class="stat"><b>{{ brands.length }}</b><span>brands, watchmakers &amp; suppliers</span></div>
            <div class="stat"><b>{{ collections.regions.length }}</b><span><a href="/states/">states &amp; provinces</a></span></div>
            <div class="stat"><b>{{ brands | foundedSince(2020) }}</b><span>founded since 2020</span></div>
            {% if oldestBrand %}<div class="stat"><b>{{ oldestBrand.data.founded }}</b><span>oldest: <a href="{{ oldestBrand.url }}">{{ oldestBrand.data.name }}</a></span></div>{% endif %}
        </div>

        {% if pick %}
        <section class="section">
            <div class="panel feature">
                {{ m.logo(pick.data, 120) }}
                <div>
                    <span class="eyebrow">Brand of the week</span>
                    <h3>{{ pick.data.name }}</h3>
                    <p>{{ pick.data.city | location(pick.data.state, pick.data.country) }}{% if pick.data.state %}, {{ pick.data.country | countryName }}{% endif %}</p>
                    <div class="chips">
                        {% if pick.data.founded %}<span class="chip">Est. {{ pick.data.founded }}</span>{% endif %}
                        {% for p in pick.data.products %}<span class="chip light">{{ p }}</span>{% endfor %}
                    </div>
                    <a class="btn" href="{{ pick.url }}">View profile</a>
                    <a class="btn ghost" href="{{ site.instagram }}" target="_blank" rel="noopener">Follow @watchmakingusa</a>
                </div>
            </div>
        </section>
        {% endif %}

        <section class="section">
            <div class="section-head"><h2>Recently added</h2><a href="/directory.html">See everyone &rarr;</a></div>
            <div class="lgrid">
                {% for b in brands | recentlyAdded(6) %}{{ m.logoTile(b) }}{% endfor %}
            </div>
        </section>

        <section class="section">
            <div class="section-head"><h2>Browse by state &amp; province</h2><a href="/states/">All {{ collections.regions.length }} &rarr;</a></div>
            <div class="chip-list">
                {% for r in collections.regions | largest(14) %}
                <a class="chip-link" href="{{ r | regionUrl }}">{{ r.name }} <span class="n">{{ r.brands.length }}</span></a>
                {% endfor %}
            </div>
        </section>

        <section class="section">
            <div class="section-head"><h2>Browse by type</h2></div>
            <div class="chip-list">
                {% for f in brands | facet("products") %}
                <a class="chip-link" href="/directory.html?product={{ f.value | urlencode }}">{{ f.value }} <span class="n">{{ f.count }}</span></a>
                {% endfor %}
            </div>
        </section>

        <section class="section">
            <div class="section-head"><h2>On the map</h2><a href="/map/">Open the full map &rarr;</a></div>
            {{ m.map(brands, "map-home", "preview", "small", "north-america") }}
        </section>
{% endblock %}

{% block scripts %}{{ m.mapScripts() }}{% endblock %}
