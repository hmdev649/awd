---
permalink: /contact.html
title: "Contact | American Watchmaking Directory"
description: "Get in touch with the American Watchmaking Directory: suggest a brand, update a listing, or ask about partnerships."
navActive: "contact"
---
{% extends "base.njk" %}

{% block head %}
    <style>
        .options { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px; max-width: 760px; }
        .option { display: block; background: #fff; border: 2px solid var(--line); border-radius: 14px; padding: 18px 20px; color: var(--ink); text-decoration: none; }
        .option:hover { border-color: var(--ink); }
        .option strong { display: block; font-family: 'Manrope', sans-serif; font-size: 1.15rem; margin-bottom: 2px; }
        .option span { color: var(--muted); font-size: .92rem; }
        .form-panel h2 { font-family: 'Manrope', sans-serif; font-size: 1.3rem; margin-bottom: 14px; }
        @media (max-width: 640px) { .options { grid-template-columns: 1fr; } }
    </style>
{% endblock %}

{% block main %}
        <div class="page-intro">
            <h1>Contact us</h1>
            <p>Most messages are about listings, so those have their own forms:</p>
        </div>

        <div class="options">
            <a class="option" href="/suggest/"><strong>Suggest a brand &rarr;</strong><span>Tell us about a brand, watchmaker or supplier we're missing.</span></a>
            <a class="option" href="/update/"><strong>Update a listing &rarr;</strong><span>Fix something wrong, or add detail to your brand's listing.</span></a>
        </div>

        <div class="panel form-panel">
            <h2>Anything else</h2>
            <form class="js-form" action="{{ site.formspree }}" method="POST" data-subject="Contact: {inquiry_type} from {name}" data-success="contact-done">
                <input type="hidden" name="form" value="contact">
                <input type="hidden" name="_subject" value="New contact form submission">
                <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"></label></div>

                <div class="form-grid">
                    <div class="field">
                        <label for="name">Name *</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="field">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="_replyto" required>
                    </div>
                    <div class="field">
                        <label for="company">Company or organization</label>
                        <input type="text" id="company" name="company">
                    </div>
                    <div class="field">
                        <label for="inquiry_type">About</label>
                        <select id="inquiry_type" name="inquiry_type">
                            <option value="General question">General question</option>
                            <option value="Partnership">Partnership</option>
                            <option value="Press">Press</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="field full">
                        <label for="message">Message *</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn">Send message</button>
                    <span class="form-status" role="status"></span>
                </div>
            </form>

            <div id="contact-done" class="form-success" hidden>
                <h2>Message received</h2>
                <p>Thanks for writing. We'll get back to you soon.</p>
            </div>
        </div>
{% endblock %}

{% block scripts %}<script src="/js/forms.js"></script>{% endblock %}
