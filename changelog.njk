---
permalink: /changelog/
title: "Changelog | American Watchmaking Directory"
description: "What has changed on the American Watchmaking Directory, the decisions behind how it is run, and the questions we haven't settled yet."
navActive: "changelog"
heading: "Changelog"
intro: 'What has changed on the site, how we decided what the directory covers, and the questions still open. Have a view on one? <a href="/contact.html">Tell us</a>.'
---
{% extends "prose.njk" %}

{%- macro entry(e) %}
                <article class="log-entry" id="{{ e.page.fileSlug | replace(r/^\d{4}-\d{2}-\d{2}-/, '') }}">
                    <h3>{{ e.data.title }}</h3>
                    <p class="log-meta">
                        <span class="chip log-kind {{ e.data.kind }}">{{ "Decision" if e.data.kind == "decision" else "Update" }}</span>
                        {%- if e.data.status and e.data.status != "decided" %} <span class="chip status log-{{ e.data.status }}">{{ { pending: "Open question", replaced: "Replaced" }[e.data.status] }}</span>{% endif %}
                        <time datetime="{{ e.page.date | isoDate }}">{{ e.page.date | isoDate | readableDate }}</time>
                    </p>
                    <p class="log-summary">{{ e.data.summary }}</p>
                    {{ e.content | safe }}
                </article>
{%- endmacro %}

{% block content %}
                <h2 id="open-questions">Open questions</h2>
                <p>Decisions we haven't made yet.</p>
                {%- for e in collections.changelog %}{% if e.data.status == "pending" %}{{ entry(e) }}{% endif %}{% endfor %}
                {%- set ns = { month: "" } %}
                {%- for e in collections.changelog %}
                {%- if e.data.status != "pending" %}
                {%- set m = e.page.date | monthYear %}
                {%- if m != ns.month %}
                {%- set ns = { month: m } %}
                <h2 id="{{ m | slugify }}">{{ m }}</h2>
                {%- endif %}
                {{ entry(e) }}
                {%- endif %}
                {%- endfor %}
{% endblock %}
