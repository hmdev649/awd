---
permalink: /directory.html
title: "Directory of American Watch Brands & Watchmakers | American Watchmaking Directory"
description: "Search and filter watch brands, independent watchmakers and suppliers in the United States and Canada by state, product type and founding year."
navActive: "directory"
eras:
  - { value: "pre-1950", label: "Before 1950" }
  - { value: "1950-1999", label: "1950–1999" }
  - { value: "2000-2019", label: "2000–2019" }
  - { value: "2020-plus", label: "2020 or later" }
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}



{% block main %}
        <div class="page-intro">
            <h1>Directory</h1>
            <p>{{ collections.brands.length }} watch brands, independent watchmakers and suppliers. Also browse by <a href="/states/">state or province</a> or on the <a href="/map/">map</a>.</p>
        </div>

        <section class="filterbar" aria-label="Filter the directory">
            <div class="filter-top">
                <label for="q" class="sr-only">Search by name, city or state</label>
                <input id="q" class="search" type="search" placeholder="Search brands or places" autocomplete="off">
                <button id="filters-toggle" class="btn ghost" type="button" aria-expanded="false" aria-controls="more-filters">Filters<span id="active-count"></span></button>
            </div>

            <div class="chip-row" role="group" aria-label="Product type" id="product-chips">
                <button type="button" class="fchip" data-value="" aria-pressed="true">All</button>
                {%- for f in collections.brands | facet("products") %}
                <button type="button" class="fchip" data-value="{{ f.value }}" aria-pressed="false">{{ f.value }} <span class="n">{{ f.count }}</span></button>
                {%- endfor %}
            </div>

            <div class="more-filters" id="more-filters">
                <div>
                    <label for="country">Country</label>
                    <select id="country">
                        <option value="">All countries</option>
                        <option value="US">United States</option>
                        <option value="CA">Canada</option>
                    </select>
                </div>
                <div>
                    <label for="region">State / Province</label>
                    <select id="region">
                        <option value="">All states &amp; provinces</option>
                        <optgroup label="United States">
                            {%- for r in collections.regions %}{% if r.country == "US" %}
                            <option value="{{ r.key }}">{{ r.name }}</option>
                            {%- endif %}{% endfor %}
                        </optgroup>
                        <optgroup label="Canada">
                            {%- for r in collections.regions %}{% if r.country == "CA" %}
                            <option value="{{ r.key }}">{{ r.name }}</option>
                            {%- endif %}{% endfor %}
                        </optgroup>
                    </select>
                </div>
                <div class="era-group">
                    <span class="label" id="era-label">Founded</span>
                    <div class="chip-row" role="group" aria-labelledby="era-label" id="era-chips">
                        {%- for e in eras %}
                        <button type="button" class="fchip" data-value="{{ e.value }}" aria-pressed="false">{{ e.label }} <span class="n"></span></button>
                        {%- endfor %}
                    </div>
                </div>
                <div>
                    <label for="sort">Sort</label>
                    <select id="sort">
                        <option value="name">Name (A–Z)</option>
                        <option value="name-desc">Name (Z–A)</option>
                        <option value="oldest">Oldest first</option>
                        <option value="newest">Newest first</option>
                        <option value="state">State / Province</option>
                    </select>
                </div>
            </div>
        </section>

        <div class="results-bar">
            <span id="results-info" aria-live="polite">Showing all {{ collections.brands.length }}</span>
            <button id="clear-all" type="button" hidden>Clear all filters</button>
        </div>

        <div class="lgrid" id="grid">
            {%- for b in collections.brands %}
            {{ m.logoTile(b) }}
            {%- endfor %}
        </div>

        <div id="no-results" hidden>
            <h2>No matches</h2>
            <p>Try a different search, or <a href="/suggest/">suggest a brand</a> we're missing.</p>
        </div>

        <button id="back-to-top" class="back-to-top" type="button" title="Back to top" aria-label="Back to top">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
        </button>
{% endblock %}

{% block scripts %}
    <script src="/js/directory.js"></script>
{% endblock %}
