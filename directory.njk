---
permalink: /directory.html
title: "Directory of American Watch Brands & Watchmakers | American Watchmaking Directory"
description: "Search and filter watch brands, independent watchmakers and suppliers in the United States and Canada by state, product type and founding year."
navActive: "directory"
eras:
  - { value: "pre-1950", label: "Before 1950" }
  - { value: "1950-1999", label: "1950–1999" }
  - { value: "2000-2019", label: "2000–2019" }
  - { value: "2020-plus", label: "2020 or later" }
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}



{% block main %}
        <div class="page-intro page-intro-wide">
            <h1>Directory</h1>
            <p>{{ collections.brands.length }} watch brands, independent watchmakers and suppliers. Also browse by <a href="/states/">state</a> or on the <a href="/map/">map</a>.</p>
        </div>

        <section class="filterbar" aria-label="Filter the directory">
            <div class="filter-top">
                <label for="q" class="sr-only">Search by name, city or state</label>
                <input id="q" class="search" type="search" placeholder="Search brands or places" autocomplete="off">
                <button id="filters-toggle" class="btn ghost" type="button" aria-expanded="false" aria-controls="more-filters">Filters<span id="active-count"></span></button>
            </div>

            <div class="chip-row" role="group" aria-label="Product type" id="product-chips">
                <button type="button" class="fchip" data-value="" aria-pressed="true">All</button>
                {%- for f in collections.brands | facet("products") %}
                <button type="button" class="fchip" data-value="{{ f.value }}" aria-pressed="false">{{ f.value }} <span class="n">{{ f.count }}</span></button>
                {%- endfor %}
            </div>

            <div class="more-filters" id="more-filters">
                <div>
                    <label for="country">Country</label>
                    <select id="country">
                        <option value="">All countries</option>
                        <option value="US">United States</option>
                        <option value="CA">Canada</option>
                    </select>
                </div>
                <div class="msel" id="region-msel">
                    <span class="label" id="region-label">State</span>
                    <button type="button" class="msel-btn" id="region-btn" aria-haspopup="true" aria-expanded="false" aria-controls="region-panel" aria-labelledby="region-label region-btn">All states</button>
                    <div class="msel-panel" id="region-panel" role="group" aria-labelledby="region-label" hidden>
                        <div class="msel-head"><span>Pick one or more</span><button type="button" id="region-clear" class="msel-clear">Clear</button></div>
                        {%- for c in [{code: "US", name: "United States"}, {code: "CA", name: "Canada"}] %}
                        <fieldset class="msel-group" data-country="{{ c.code }}">
                            <legend>{{ c.name }}</legend>
                            {%- for r in collections.regions %}{% if r.country == c.code %}
                            <label><input type="checkbox" value="{{ r.key }}" data-name="{{ r.name }}"> <span class="msel-name">{{ r.name }}</span> <span class="n"></span></label>
                            {%- endif %}{% endfor %}
                        </fieldset>
                        {%- endfor %}
                    </div>
                </div>
                <div class="msel" id="era-msel">
                    <span class="label" id="era-label">Founded</span>
                    <button type="button" class="msel-btn" id="era-btn" aria-haspopup="true" aria-expanded="false" aria-controls="era-panel" aria-labelledby="era-label era-btn">Any year</button>
                    <div class="msel-panel msel-narrow" id="era-panel" role="group" aria-labelledby="era-label" hidden>
                        <div class="msel-head"><span>Pick one or more</span><button type="button" id="era-clear" class="msel-clear">Clear</button></div>
                        <fieldset class="msel-group msel-one-col">
                            <legend class="sr-only">Founded</legend>
                            {%- for e in eras %}
                            <label><input type="checkbox" value="{{ e.value }}" data-name="{{ e.label }}"> <span class="msel-name">{{ e.label }}</span> <span class="n"></span></label>
                            {%- endfor %}
                        </fieldset>
                    </div>
                </div>
                <div class="verified-group">
                    <span class="label" id="verified-label">Brand input</span>
                    <div class="chip-row" role="group" aria-labelledby="verified-label">
                        <button type="button" class="fchip" id="verified-chip" aria-pressed="false">Details confirmed by the brand <span class="n"></span></button>
                    </div>
                </div>
            </div>
        </section>

        <div class="results-bar">
            <div class="results-count">
                <span id="results-info" aria-live="polite">Showing all {{ collections.brands.length }}</span>
                <button id="clear-all" type="button" hidden>Clear all filters</button>
            </div>
            <div class="sort-control">
                <label for="sort">Sort</label>
                <select id="sort">
                    <option value="name">Name (A–Z)</option>
                    <option value="name-desc">Name (Z–A)</option>
                    <option value="oldest">Oldest first</option>
                    <option value="newest">Newest first</option>
                    <option value="state">State</option>
                </select>
            </div>
        </div>

        <div class="lgrid" id="grid">
            {%- for b in collections.brands %}
            {{ m.logoTile(b) }}
            {%- endfor %}
        </div>

        <div id="no-results" hidden>
            <h2>No matches</h2>
            <p>Try a different search, or <a href="/suggest/">suggest a brand</a> we're missing.</p>
        </div>

        <button id="back-to-top" class="back-to-top" type="button" title="Back to top" aria-label="Back to top">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
        </button>
{% endblock %}

{% block scripts %}
    <script src="/js/directory.js"></script>
{% endblock %}
