---
permalink: /states/
title: "American Watch Brands by State | American Watchmaking Directory"
description: "Browse watch brands, independent watchmakers and suppliers by US state and Canadian province, from California and New York to British Columbia."
navActive: "states"
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}
{%- set placed = collections.regions | brandCount -%}

{% block head %}{{ m.mapAssets() }}{% endblock %}

{% block main %}
        <div class="page-intro">
            <h1>Browse by state</h1>
            <p>There are listings in {{ (collections.regions | regionSummary).text }}. Pick one to see who's there.</p>
        </div>

        {{ m.map(collections.brands, "map-states", "preview", "small", "north-america") }}

        {% for country in ["US", "CA"] %}
        <section class="section">
            <div class="section-head"><h2>{{ country | countryName }}</h2></div>
            <div class="region-grid">
                {% for r in collections.regions %}{% if r.country == country %}
                <a class="region-tile" href="{{ r | regionUrl }}"><strong>{{ r.name }}</strong><span>{{ r.brands.length }}<span class="word"> listing{{ "s" if r.brands.length != 1 }}</span></span></a>
                {% endif %}{% endfor %}
            </div>
        </section>
        {% endfor %}

        {% if collections.brands.length > placed %}
        <p class="map-note">{{ collections.brands.length - placed }} listings don't have a state yet. <a href="/directory.html">See them all in the directory</a>.</p>
        {% endif %}
{% endblock %}

{% block scripts %}{{ m.mapScripts() }}{% endblock %}
