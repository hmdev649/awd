{% extends "base.njk" %}
{% import "macros.njk" as m with context %}
{%- set loc = city | location(state, country) -%}
{%- set bodyText = content | plainText -%}
{%- set title = name + " — " + loc + " | " + site.name -%}
{%- if bodyText -%}
  {%- set description = bodyText | truncate(155) -%}
{%- else -%}
  {%- set description = name + ": " + (products | join(", ") | lower) + " from " + loc + ((", " + (country | countryName)) if state else "") + ((". Founded " + founded) if founded else "") + ". Listed in the " + site.name + "." -%}
{%- endif -%}
{%- set ogImage = ("/images/logos/" + logo) if logo else site.ogImage -%}
{%- set navActive = "directory" -%}
{%- set tier = tiers[made_in_america] if made_in_america else null -%}
{%- set regionGroup = collections.regions | regionGroup(region) -%}

{% block head %}
    <script type="application/ld+json">{{ {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": name,
        "url": website or (site.url + page.url),
        "logo": (site.url + "/images/logos/" + logo) if logo else undefined,
        "foundingDate": (founded | string) if founded else undefined,
        "address": { "@type": "PostalAddress", "addressLocality": city or undefined, "addressRegion": state or undefined, "addressCountry": country },
        "sameAs": [instagram] if instagram else undefined
    } | json | safe }}</script>
    <script type="application/ld+json">{{ {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Directory", "item": site.url + "/directory.html" },
            { "@type": "ListItem", "position": 2, "name": region.name, "item": site.url + (region | regionUrl) } if region else undefined,
            { "@type": "ListItem", "position": 3 if region else 2, "name": name }
        ] | select
    } | json | safe }}</script>
{% endblock %}

{% block main %}
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/directory.html">Directory</a><span class="sep" aria-hidden="true">&rsaquo;</span>
            {%- if region %}<a href="{{ region | regionUrl }}">{{ region.name }}</a><span class="sep" aria-hidden="true">&rsaquo;</span>{% endif -%}
            <span aria-current="page">{{ name }}</span>
        </nav>

        <article>
            <header class="brand-head">
                <div class="brand-logo">
                    <span class="ltile-art">
                        {%- if thumb -%}
                        <img src="{{ thumb.src2x }}" srcset="{{ thumb.src2x }} 256w, {{ thumb.large }} 512w" sizes="(max-width: 600px) 96px, 150px" alt="{{ name }} logo" width="256" height="256">
                        {%- else -%}
                        <span class="monogram" aria-hidden="true">{{ name | first | upper }}</span>
                        {%- endif -%}
                    </span>
                </div>
                <div>
                    <h1>{{ name }}</h1>
                    <p class="brand-sub">
                        {%- if region %}{% if city %}{{ city }}, {% endif %}<a href="{{ region | regionUrl }}">{{ region.name }}</a>, {{ country | countryName }}{% else %}{{ loc }}{% endif -%}
                    </p>
                    {% if status and statusLabels[status] %}<span class="chip status {{ status }}">{{ statusLabels[status] }}</span>{% endif %}
                </div>
            </header>

            <div class="brand-layout">
                <aside class="card glance" aria-labelledby="glance-h">
                    <h2 id="glance-h">At a glance</h2>
                    <dl>
                        <dt>Based in</dt>
                        <dd>{{ loc }}{% if state %}, {{ country | countryName }}{% endif %}</dd>
                        {% if founded %}<dt>Founded</dt><dd>{{ founded }}{% if revived %} (revived {{ revived }}){% endif %}</dd>{% endif %}
                        {% if products and products.length %}<dt>Makes</dt><dd>{{ products | join(", ") }}</dd>{% endif %}
                        {% if movements and movements.length %}<dt>Movements</dt><dd>{{ movements | join(", ") | capitalize }}</dd>{% endif %}
                        {% if tier %}<dt>Made in America</dt><dd>{{ tier.label }}</dd>{% endif %}
                    </dl>
                    {% if website or instagram or email %}
                    <div class="btn-row">
                        {% if website %}<a class="btn" href="{{ website }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.93-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>Website</a>{% endif %}
                        {% if instagram %}<a class="btn{% if website %} ghost{% endif %}" href="{{ instagram }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true">{% include "icon-instagram.njk" %}</svg>Instagram</a>{% endif %}
                        {% if email %}<a class="btn ghost" href="mailto:{{ email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>Email</a>{% endif %}
                    </div>
                    {% endif %}
                </aside>

                <div class="panel brand-main">
                    {% if status == "inactive" or status == "defunct" %}
                    <div class="notice">
                        <span class="chip status {{ status }}">{{ statusLabels[status] }}</span>
                        <p>As far as we know, {{ name }} is no longer making or selling products. We keep the listing for the record. Know otherwise? <a href="/update/?brand={{ name | urlencode }}">Let us know</a>.</p>
                    </div>
                    {% elif status == "upcoming" %}
                    <div class="notice">
                        <span class="chip status upcoming">{{ statusLabels.upcoming }}</span>
                        <p>{{ name }} hasn't released products yet.</p>
                    </div>
                    {% endif %}

                    {% if tier %}
                    <div class="notice tier-box">
                        <span class="chip tier">{{ tier.short }}</span>
                        <div>
                            <strong>{{ tier.label }}</strong>
                            <p>{{ tier.description }}</p>
                        </div>
                    </div>
                    {% endif %}

                    {% if photos and photos.length %}
                    <div class="gallery">
                        {% for p in photos %}
                        <figure>
                            <img src="{{ ('/' + p.src) | replace('//', '/') }}" alt="{{ p.alt }}" loading="lazy" decoding="async">
                            {% if p.credit %}<figcaption>Photo: {{ p.credit }}</figcaption>{% endif %}
                        </figure>
                        {% endfor %}
                    </div>
                    {% endif %}

                    <div class="brand-body">
                        {% if bodyText %}
                        {{ content | safe }}
                        {% else %}
                        <div class="placeholder">
                            <p>We're still writing this profile. Know {{ name }} well, or work there? <a href="/update/?brand={{ name | urlencode }}">Send us details</a> about what they make and what's made in America.</p>
                        </div>
                        {% endif %}

                        {% if sources and sources.length %}
                        <h2>Sources</h2>
                        <ol class="sources">
                            {% for s in sources %}<li><a href="{{ s }}" target="_blank" rel="noopener">{{ s | replace("https://", "") | replace("http://", "") | replace("www.", "") }}</a></li>{% endfor %}
                        </ol>
                        {% endif %}
                    </div>

                    <div class="brand-meta">
                        <span>{% if last_updated %}Last updated {{ last_updated | readableDate }}{% endif %}</span>
                        <span>Is this your brand, or is something wrong? <a href="/update/?brand={{ name | urlencode }}">Update this listing</a></span>
                    </div>
                </div>
            </div>
        </article>

        {% if regionGroup %}
        {%- set neighbors = regionGroup.brands | others(page.url) -%}
        {% if neighbors.length %}
        <section class="section">
            <div class="section-head">
                <h2>More in {{ regionGroup.name }}</h2>
                <a href="{{ region | regionUrl }}">All {{ regionGroup.brands.length }} in {{ regionGroup.name }} &rarr;</a>
            </div>
            <div class="lgrid">
                {% for b in neighbors | batch(6) | first %}{{ m.logoTile(b) }}{% endfor %}
            </div>
        </section>
        {% endif %}
        {% endif %}
{% endblock %}
